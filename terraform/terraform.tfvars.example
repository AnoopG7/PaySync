# ──────────────────────────────────────────────────────────────────────────────
# PaySync Cloud — Terraform Variables Example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform apply
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Your public IP for SSH + Jenkins access ──
# Find it: curl -s http://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.5/32"

# ── REQUIRED: RDS master password ──
rds_master_password = "YourStrongPassword123!"

# ── REQUIRED: Name of your existing AWS key pair (created in AWS Console, ap-south-1) ──
# Your .pem file sits locally; Terraform just needs the name.
key_pair_name = "ec2-key"
